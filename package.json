{
  "name": "@aromix/core",
  "version": "0.5.8",
  "description": "The Core Package For Aromix",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/aromixjs/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/aromixjs/core.git"
  },
  "bugs": {
    "url": "https://github.com/aromixjs/core/issues"
  },
  "keywords": [
    "aromix",
    "core",
    "server",
    "framework",
    "node",
    "rpc"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "change": "beachball change",
    "bump": "beachball bump",
    "release": "beachball publish --yes --access public"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "beachball": "^2.65.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
